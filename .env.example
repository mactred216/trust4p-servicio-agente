# Cadena de conexión a la misma base de datos documental que trust4p-api-negocio.
# Este servicio accede en modo de solo lectura a la colección fragmentos_conocimiento
# (ver ADR-004 en trust4p-api-negocio) y no escribe en ninguna colección transaccional.
MONGO_URI=

GCP_PROJECT_ID=
GCP_REGION=us-central1
# Vertex AI solo ofrece Qwen3-Next-80B-Instruct por el endpoint 'global',
# no por una región regular como us-central1 (confirmado en vivo).
GCP_INFERENCIA_REGION=global

# Secreto compartido con trust4p-api-negocio para autenticar las llamadas
# de servicio a servicio (no es una sesión de usuario). Debe tener el mismo
# valor en el .env de ambos repos.
API_KEY_SERVICIOS=

# Orígenes del frontend autorizados por CORS (separados por coma). El panel de
# auditoría del administrador consulta GET /v1/ejecuciones desde el navegador.
CORS_ORIGENES=http://localhost:5173,http://localhost:3000
